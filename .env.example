APP_NAME=

DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=

DB_PORT=
API_PORT=

JWT_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_TTL=

PROMETHEUS_PORT=

GRAFANA_PORT=
GRAFANA_USER=
GRAFANA_PASSWORD=

# Фронт и демо-стенд (make demo-up)
# порт фронта (8081)
WEB_PORT=
# учётка демо-парка: генератор заведёт её, а на экране входа появится кнопка «Войти в демо-парк».
# Пароль попадает в сборку фронта — это публичная витрина, не используйте его где-то ещё
FLEET_DEMO_EMAIL=
FLEET_DEMO_PASSWORD=
# роль демо-учётки: DISPATCHER — может менять парк (но не людей), ANALYTIC — только смотреть (DISPATCHER).
# Администратор демо-организации служебный, его пароль не публикуется
FLEET_DEMO_ROLE=
# ускорение времени генератора (60)
FLEET_SCALE=

TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Необязательные параметры, в скобках значение по умолчанию
# debug | info | warn | error (info)
LOG_LEVEL=
# json | text (json): json - для сборщиков логов, text - читать глазами локально
LOG_FORMAT=
# открыть /swagger/ (false): на публичном стенде карта API ни к чему
SWAGGER_ENABLED=
# сколько SSE-потоков может держать один пользователь (5)
STREAMS_PER_USER=
# насколько device_timestamp может опережать часы сервера (2m). Для демо-стенда с FLEET_SCALE > 1
# время генератора убегает вперёд, и допуск приходится поднимать (например 720h) - только на витрине
TELEMETRY_MAX_CLOCK_AHEAD=
# внутренний порт /metrics для Prometheus (9091)
METRICS_PORT=
# таймаут обработки HTTP-запроса (5s)
REQUEST_TIMEOUT=
# размер пула соединений (50)
DB_MAX_CONNS=
# число воркеров оценки алертов (16)
ALERT_WORKERS=
# размер очереди алертов (10000)
ALERT_QUEUE_SIZE=
# максимум записей в пачке (100)
TELEMETRY_BATCH_SIZE=
# максимальное ожидание пачки (20ms)
TELEMETRY_BATCH_WAIT=
# буфер заявок на запись телеметрии (10000)
TELEMETRY_BUFFER_SIZE=
# срок хранения метрик (15d)
PROMETHEUS_RETENTION=
